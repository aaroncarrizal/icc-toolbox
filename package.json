{
  "name": "icc-toolbox",
  "version": "1.0.0",
  "description": "ICC dealer-site toolbox: CSS injection with hot reload, live source toggling and a CDP debug CLI",
  "type": "module",
  "bin": {
    "icc-toolbox": "./dist/index.js"
  },
  "scripts": {
    "dev": "node src/tools/css-injector/index.ts",
    "css": "node src/tools/css-injector/css-cli.ts",
    "dbg": "node src/tools/css-injector/dbg.ts",
    "clamp": "node src/tools/units/clamp.ts",
    "vw": "node src/tools/units/vw.ts",
    "vh": "node src/tools/units/vh.ts",
    "img:png": "node src/tools/image-convert/index.ts",
    "build": "vite build",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "css",
    "inject",
    "hot-reload",
    "cdp",
    "devtools"
  ],
  "license": "MIT",
  "dependencies": {
    "chokidar": "^4.0.3",
    "commander": "^13.1.0",
    "fast-glob": "^3.3.3",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "vite": "^6.2.3"
  }
}
